{
  "name": "ig-comment-dm",
  "version": "1.5.0",
  "description": "Comment a keyword, get the link in your DMs. A self-hosted Instagram comment-to-DM tool with a dashboard, on a free Cloudflare Worker.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Chitransh Motwani",
  "keywords": [
    "instagram",
    "comment-to-dm",
    "instagram-api",
    "cloudflare-workers",
    "durable-objects",
    "automation",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theChitranshM/ig-comment-dm.git"
  },
  "homepage": "https://github.com/theChitranshM/ig-comment-dm#readme",
  "bugs": "https://github.com/theChitranshM/ig-comment-dm/issues",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "admin": "node scripts/admin.mjs",
    "deploy": "npx --yes wrangler@4.160.0 deploy",
    "logs": "npx --yes wrangler@4.160.0 tail --format pretty",
    "test": "node --import ./test/register-html.mjs --test test/worker.test.js test/api.test.js test/alerts.test.js",
    "dev:ui": "node scripts/ui-mock.mjs"
  }
}
